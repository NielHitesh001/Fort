# Loopback only. Credentials remain on the Node server, never NEXT_PUBLIC_*.
PORT=3000
CORRIDOR_ENGINE_URL=http://127.0.0.1:8080
CORRIDOR_METRICS_URL=http://127.0.0.1:9090
CORRIDOR_API_TOKEN=
CORRIDOR_METRICS_TOKEN=
# Optional immutable copy of an actual little-endian v2 RecoveryLedger.
# Stop its writer before copying. Maximum 4 MiB. No arbitrary browser file paths.
CORRIDOR_LEDGER_PATH=
