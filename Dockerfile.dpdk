FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    meson \
    ninja-build \
    pkg-config \
    python3 \
    python3-pyelftools \
    libnuma-dev \
    libdpdk-dev \
    libssl-dev

WORKDIR /workspace

# Verify DPDK headers exist
RUN ls -la /usr/include/dpdk/ | head -10 && \
    echo "DPDK headers found"

CMD ["/bin/bash"]
