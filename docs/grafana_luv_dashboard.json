{
  "title": "LUV Terminal",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Session PnL",
      "datasource": "Prometheus",
      "targets": [{ "expr": "luv_session_pnl" }],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "type": "stat",
      "title": "Active Orders",
      "datasource": "Prometheus",
      "targets": [{ "expr": "luv_active_orders" }],
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Risk Latency",
      "datasource": "Prometheus",
      "targets": [{ "expr": "luv_risk_ns" }],
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ns" } }
    },
    {
      "type": "timeseries",
      "title": "Fill Count",
      "datasource": "Prometheus",
      "targets": [{ "expr": "rate(luv_fill_count[5m])" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Rejected Orders",
      "datasource": "Prometheus",
      "targets": [{ "expr": "rate(luv_reject_count[5m])" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    }
  ]
}
